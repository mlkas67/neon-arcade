{
  "id": "/",
  "name": "Legeniko Arcade — twelve games",
  "short_name": "Legeniko Arcade",
  "description": "Twelve neon arcade games in the browser: Geometry Dash, Flappy Bird, 2048, three 3D worlds and more. Installs as an app and plays offline.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "landscape",
  "background_color": "#08080f",
  "theme_color": "#08080f",
  "categories": [
    "games",
    "entertainment"
  ],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
