{
  "id": "/",
  "name": "Neon Arcade — ten games",
  "short_name": "Neon Arcade",
  "description": "Ten neon browser games — Geometry Dash, Flappy Bird, Neon Vice, Breakout, Snake, 2048, Asteroids, Pong, Memory and Whack-a-Bot — installable and offline.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "landscape",
  "background_color": "#08080f",
  "theme_color": "#08080f",
  "categories": [
    "games",
    "entertainment"
  ],
  "lang": "en",
  "dir": "ltr",
